{
  "name": "@hector21/octoform",
  "version": "0.3.1",
  "description": "Declarative plan/apply governance for GitHub repositories: settings, branch rules, environments and files, from one YAML file",
  "keywords": [
    "github",
    "governance",
    "octokit",
    "rulesets",
    "branch-protection",
    "repository-settings",
    "compliance",
    "infrastructure-as-code"
  ],
  "homepage": "https://hector-ae21.github.io/octoform-docs/0.3/",
  "bugs": {
    "url": "https://github.com/hector-ae21/octoform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hector-ae21/octoform.git"
  },
  "license": "MIT",
  "author": "Hector Arrechea <hectorlazaroarrechea@gmail.com> (https://github.com/hector-ae21)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "octoform": "bin/octoform.js"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src bin scripts",
    "test": "npm run lint && npm run test:source-policy && npm run api-docs:check && npm run reference-artifacts:check && tsc -p tsconfig.test.json && node scripts/run-tests.mjs && npm run test:readme",
    "test:readme": "node scripts/validate-readme.mjs",
    "test:source-policy": "node scripts/verify-source-policy.mjs",
    "api-docs": "node scripts/generate-api-docs.mjs",
    "api-docs:check": "node scripts/generate-api-docs.mjs --check",
    "reference-artifacts": "node scripts/generate-reference-artifacts.mjs",
    "reference-artifacts:check": "node scripts/generate-reference-artifacts.mjs --check",
    "api-surface": "node scripts/generate-api-surface.mjs",
    "api-surface:check": "node scripts/generate-api-surface.mjs --check",
    "octoform": "node bin/octoform.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@microsoft/tsdoc": "^0.16.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-tsdoc": "^0.5.2",
    "ts-json-schema-generator": "2.3.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0"
  }
}
