{
  "name": "@hector21/octoform",
  "version": "0.3.0",
  "description": "Declarative plan/apply governance for GitHub repositories: settings, branch rules, environments and files, from one YAML file",
  "keywords": [
    "github",
    "governance",
    "octokit",
    "rulesets",
    "branch-protection",
    "repository-settings",
    "compliance",
    "infrastructure-as-code"
  ],
  "homepage": "https://github.com/hector-ae21/octoform#readme",
  "bugs": {
    "url": "https://github.com/hector-ae21/octoform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hector-ae21/octoform.git"
  },
  "license": "MIT",
  "author": "Hector Arrechea <hectorlazaroarrechea@gmail.com> (https://github.com/hector-ae21)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "octoform": "bin/octoform.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "octoform": "node bin/octoform.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
