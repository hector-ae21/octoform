{
  "schemaVersion": 1,
  "sources": {
    "githubRestApiVersion": "2026-03-10",
    "apiSurface": "github-api-surface.json",
    "fineGrainedPatPermissions": "https://docs.github.com/en/rest/authentication/permissions-required-for-fine-grained-personal-access-tokens?apiVersion=2026-03-10",
    "githubAppPermissions": "https://docs.github.com/en/rest/authentication/permissions-required-for-github-apps?apiVersion=2026-03-10",
    "classicScopes": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/scopes-for-oauth-apps"
  },
  "permissions": [
    {
      "id": "classic-repo",
      "tokenType": "classic-pat",
      "scope": "account",
      "name": "repo",
      "access": "read-write",
      "description": "Coarse classic scope required by the current CLI preflight for every command."
    },
    {
      "id": "classic-admin-org",
      "tokenType": "classic-pat",
      "scope": "organization",
      "name": "admin:org",
      "access": "write",
      "description": "Additional classic scope required before organization custom-property writes."
    },
    {
      "id": "repository-metadata-read",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Metadata",
      "access": "read",
      "description": "Repository discovery and public repository metadata."
    },
    {
      "id": "repository-administration-read",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Administration",
      "access": "read",
      "description": "Administrative settings, rulesets, environments, and security configuration state."
    },
    {
      "id": "repository-administration-write",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Administration",
      "access": "write",
      "description": "Repository settings, branch rename, rulesets, environments, and supported security configuration changes."
    },
    {
      "id": "repository-contents-read",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Contents",
      "access": "read",
      "description": "Repository files, workflows, branches, and Git references used as observed state."
    },
    {
      "id": "repository-contents-write",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Contents",
      "access": "write",
      "description": "Branch creation and create-if-missing file writes."
    },
    {
      "id": "organization-custom-properties-read",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Custom properties",
      "access": "read",
      "description": "Organization repository property definitions and values."
    },
    {
      "id": "organization-custom-properties-write",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Custom properties",
      "access": "write",
      "description": "Organization repository property values."
    },
    {
      "id": "organization-custom-properties-admin",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Custom properties",
      "access": "admin",
      "description": "Organization custom-property definitions."
    },
    {
      "id": "organization-administration-write",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Administration",
      "access": "write",
      "description": "Organization ruleset capability discovery for an organization administrator."
    }
  ],
  "routePermissions": {
    "GET /orgs/{org}/rulesets": [
      "classic-repo",
      "classic-admin-org",
      "organization-administration-write"
    ],
    "PUT /orgs/{org}/properties/schema/{custom_property_name}": [
      "classic-repo",
      "classic-admin-org",
      "organization-custom-properties-admin"
    ],
    "PATCH /orgs/{org}/properties/values": [
      "classic-repo",
      "classic-admin-org",
      "organization-custom-properties-write"
    ]
  },
  "capabilities": [
    {
      "id": "authenticated-identity",
      "area": "discovery",
      "support": "supported",
      "configPaths": [],
      "commands": ["audit", "plan", "apply", "classify", "properties sync"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /user"],
      "writeRoutes": [],
      "writeMutations": [],
      "readPermissions": ["classic-repo"],
      "writePermissions": [],
      "limitations": ["Some token types do not expose an authenticated user login or classic scope headers."]
    },
    {
      "id": "owner-kind",
      "area": "discovery",
      "support": "supported",
      "configPaths": ["owner"],
      "commands": ["audit", "plan", "apply", "classify", "properties sync"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /orgs/{org}", "GET /users/{username}"],
      "writeRoutes": [],
      "writeMutations": [],
      "readPermissions": ["classic-repo"],
      "writePermissions": [],
      "limitations": ["Owner kind is discovered from GitHub and is never declared in configuration."]
    },
    {
      "id": "repository-inventory",
      "area": "discovery",
      "support": "supported",
      "configPaths": ["exclude.repos", "repos"],
      "commands": ["audit", "plan", "apply", "classify", "properties sync"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": [
        "GET /orgs/{org}/repos",
        "GET /user/repos",
        "GET /users/{username}/repos",
        "GET /repos/{owner}/{repo}"
      ],
      "writeRoutes": [],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read"],
      "writePermissions": [],
      "limitations": ["Another personal account exposes public repositories only; the authenticated owner can expose repositories granted to the token."]
    },
    {
      "id": "audit-expectations",
      "area": "audit",
      "support": "observational",
      "configPaths": ["audit"],
      "commands": ["audit"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": [],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read"],
      "writePermissions": [],
      "limitations": ["Audit findings are informational and do not change the command exit code."]
    },
    {
      "id": "repository-features",
      "area": "repository",
      "support": "supported",
      "configPaths": ["features.issues", "features.wiki", "features.projects"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": ["PATCH /repos/{owner}/{repo}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": []
    },
    {
      "id": "repository-discussions",
      "area": "repository",
      "support": "supported",
      "configPaths": ["features.discussions"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": [],
      "writeMutations": ["updateRepository"],
      "readPermissions": ["classic-repo", "repository-metadata-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "The REST repository response reports the field but its PATCH body cannot change it; the change is made by the GraphQL updateRepository mutation, so a repository whose node id could not be read blocks instead."
      ]
    },
    {
      "id": "repository-graphql-settings",
      "area": "repository",
      "support": "supported",
      "configPaths": ["features.sponsorships", "features.pull_requests", "repo.issue_creation", "repo.pull_request_creation"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": [],
      "writeRoutes": [],
      "writeMutations": ["updateRepository"],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "The REST API exposes none of these settings; both the read and the change go through GraphQL, and only the mutation half has an identity this register can name.",
        "A failed GraphQL read leaves every one of them unreadable, which blocks the change rather than planning over an assumed value."
      ]
    },
    {
      "id": "repository-guarded-changes",
      "area": "repository",
      "support": "supported",
      "configPaths": ["repo.visibility", "repo.archived", "repo.template", "repo.name", "repo.rename_from"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": ["PATCH /repos/{owner}/{repo}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "A rename must declare repo.rename_from, so that a shared policy layer cannot rename every repository it covers.",
        "Repositories are declared under repos.<name>, so the entry that asked for a rename stops matching once it is applied; the plan reports that as a warning.",
        "GitHub reports internal visibility but does not accept it back, so leaving it is reported as a change the configuration cannot reverse.",
        "Archiving is sent after every other change and only if they all succeeded; unarchiving is sent before them. An archived repository with no unarchive declared is not planned against at all."
      ]
    },
    {
      "id": "merge-settings",
      "area": "repository",
      "support": "supported",
      "configPaths": ["merge"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": ["PATCH /repos/{owner}/{repo}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": []
    },
    {
      "id": "repository-metadata",
      "area": "repository",
      "support": "supported",
      "configPaths": ["repo.description", "repo.homepage", "repo.allow_forking", "repo.web_commit_signoff_required"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": ["PATCH /repos/{owner}/{repo}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": []
    },
    {
      "id": "repository-topics",
      "area": "repository",
      "support": "supported",
      "configPaths": ["repo.topics"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": ["PUT /repos/{owner}/{repo}/topics"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": []
    },
    {
      "id": "secret-scanning-settings",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.secret_scanning", "security.secret_scanning_push_protection"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": ["PATCH /repos/{owner}/{repo}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["An omitted security_and_analysis field is unreadable and blocks mutation instead of being treated as disabled."]
    },
    {
      "id": "vulnerability-alerts",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.vulnerability_alerts"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/vulnerability-alerts"],
      "writeRoutes": ["PUT /repos/{owner}/{repo}/vulnerability-alerts", "DELETE /repos/{owner}/{repo}/vulnerability-alerts"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["A forbidden or unavailable endpoint is reported as unreadable state."]
    },
    {
      "id": "automated-security-fixes",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.automated_security_fixes"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/automated-security-fixes"],
      "writeRoutes": ["PUT /repos/{owner}/{repo}/automated-security-fixes", "DELETE /repos/{owner}/{repo}/automated-security-fixes"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["A forbidden or unavailable endpoint is reported as unreadable state."]
    },
    {
      "id": "private-vulnerability-reporting",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.private_vulnerability_reporting"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/private-vulnerability-reporting"],
      "writeRoutes": ["PUT /repos/{owner}/{repo}/private-vulnerability-reporting", "DELETE /repos/{owner}/{repo}/private-vulnerability-reporting"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["A forbidden or unavailable endpoint is reported as unreadable state."]
    },
    {
      "id": "code-scanning-default-setup",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.code_scanning_default_setup"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/code-scanning/default-setup"],
      "writeRoutes": ["PATCH /repos/{owner}/{repo}/code-scanning/default-setup"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["A forbidden or unavailable endpoint is reported as unreadable state."]
    },
    {
      "id": "immutable-releases",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.immutable_releases"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/immutable-releases"],
      "writeRoutes": [
        "PUT /repos/{owner}/{repo}/immutable-releases",
        "DELETE /repos/{owner}/{repo}/immutable-releases"
      ],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "An owner that enforces immutable releases leaves the setting readable but not writable, so a change is reported as blocked rather than attempted."
      ]
    },
    {
      "id": "default-branch-rename",
      "area": "branches",
      "support": "supported",
      "configPaths": ["default_branch.name", "default_branch.rename_from"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}", "GET /repos/{owner}/{repo}/contents/{path}"],
      "writeRoutes": ["POST /repos/{owner}/{repo}/branches/{branch}/rename"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read", "repository-contents-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["Rename is guarded by rename_from and workflow references are reported but never rewritten."]
    },
    {
      "id": "ensured-branches",
      "area": "branches",
      "support": "supported",
      "configPaths": ["ensure_branches"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/branches/{branch}", "GET /repos/{owner}/{repo}/git/ref/{ref}"],
      "writeRoutes": ["POST /repos/{owner}/{repo}/git/refs"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-contents-read"],
      "writePermissions": ["classic-repo", "repository-contents-write"],
      "limitations": ["A missing branch is created from the current default branch; existing branches are never changed or deleted."]
    },
    {
      "id": "branch-protection",
      "area": "branches",
      "support": "supported",
      "configPaths": ["branch_protection"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": [
        "GET /repos/{owner}/{repo}/branches/{branch}/protection",
        "GET /repos/{owner}/{repo}/branches/{branch}"
      ],
      "writeRoutes": [
        "PUT /repos/{owner}/{repo}/branches/{branch}/protection",
        "POST /repos/{owner}/{repo}/branches/{branch}/protection/required_signatures",
        "DELETE /repos/{owner}/{repo}/branches/{branch}/protection/required_signatures"
      ],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "The update endpoint has no partial form and reads an omitted member as a removal, so the current protection is read and declared keys are folded over it.",
        "Protection is never removed from a branch the policy stops naming; only a declared value changes anything.",
        "A branch also governed by a declared ruleset is blocked on both sides, because GitHub applies both and the stricter wins per rule."
      ]
    },
    {
      "id": "repository-rulesets",
      "area": "rules",
      "support": "supported-with-capability-evidence",
      "configPaths": ["rulesets"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": [
        "GET /orgs/{org}/rulesets",
        "GET /repos/{owner}/{repo}/branches/{branch}/protection",
        "GET /repos/{owner}/{repo}/rulesets",
        "GET /repos/{owner}/{repo}/rulesets/{ruleset_id}"
      ],
      "writeRoutes": ["POST /repos/{owner}/{repo}/rulesets", "PUT /repos/{owner}/{repo}/rulesets/{ruleset_id}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["Private repositories require positive owner, repository, token, and API evidence; unknown remote rule types are not removed."]
    },
    {
      "id": "ruleset-bypass-actors",
      "area": "rules",
      "support": "supported",
      "configPaths": ["rulesets[].bypass"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": [
        "GET /repos/{owner}/{repo}/rulesets/{ruleset_id}",
        "GET /users/{username}",
        "GET /orgs/{org}/teams/{team_slug}",
        "GET /apps/{app_slug}"
      ],
      "writeRoutes": ["POST /repos/{owner}/{repo}/rulesets", "PUT /repos/{owner}/{repo}/rulesets/{ruleset_id}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "Names are resolved while reading, so a name GitHub does not know blocks the ruleset in plan instead of failing during apply.",
        "Repository roles are declared by numeric id: the REST surface has no route mapping a repository-role name to one.",
        "Teams and organization admins are blocked on a personal repository, and pull_request bypass on deploy keys or non-branch rulesets.",
        "Omitting bypass preserves the stored actors, since updating a ruleset replaces the whole list."
      ]
    },
    {
      "id": "ruleset-required-workflows",
      "area": "rules",
      "support": "supported",
      "configPaths": ["rulesets[].required_workflows"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/rulesets/{ruleset_id}", "GET /repos/{owner}/{repo}"],
      "writeRoutes": ["POST /repos/{owner}/{repo}/rulesets", "PUT /repos/{owner}/{repo}/rulesets/{ruleset_id}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "A workflow's repository is declared by name and resolved to the id GitHub stores; writing repository_id directly skips the lookup.",
        "A declared workflow is compared against the stored one through that id, so the same path in another repository is a different requirement."
      ]
    },
    {
      "id": "repository-collaborators",
      "area": "access",
      "support": "supported",
      "configPaths": ["access.users"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/collaborators", "GET /repos/{owner}/{repo}/invitations"],
      "writeRoutes": [
        "PUT /repos/{owner}/{repo}/collaborators/{username}",
        "DELETE /repos/{owner}/{repo}/collaborators/{username}",
        "PATCH /repos/{owner}/{repo}/invitations/{invitation_id}",
        "DELETE /repos/{owner}/{repo}/invitations/{invitation_id}"
      ],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "Only direct collaborators are managed; access reaching the repository through a team or an organization base permission is left alone.",
        "Granting access to someone who is not a collaborator yet creates an invitation, so the change reports an invitation rather than a grant.",
        "A pending invitation is amended rather than re-sent, and cannot be amended to a custom repository role.",
        "A personal repository grants collaborators write access only; any other level is blocked.",
        "The account octoform authenticates as cannot revoke its own admin access.",
        "A login the policy does not name is never revoked; revoking is spelled none."
      ]
    },
    {
      "id": "team-repository-access",
      "area": "access",
      "support": "supported",
      "configPaths": ["access.teams"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization"],
      "readRoutes": ["GET /repos/{owner}/{repo}/teams"],
      "writeRoutes": [
        "PUT /orgs/{org}/teams/{team_slug}/repos/{owner}/{repo}",
        "DELETE /orgs/{org}/teams/{team_slug}/repos/{owner}/{repo}"
      ],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "Blocked on a personal repository, which has no teams.",
        "A team the policy does not name keeps whatever access it has; revoking is spelled none."
      ]
    },
    {
      "id": "deployment-environments",
      "area": "environments",
      "support": "supported",
      "configPaths": ["environments"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/environments", "GET /users/{username}"],
      "writeRoutes": ["PUT /repos/{owner}/{repo}/environments/{environment_name}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["Declared reviewers resolve to users only; an observed team reviewer blocks replacement."]
    },
    {
