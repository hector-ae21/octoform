{
  "schemaVersion": 1,
  "sources": {
    "githubRestApiVersion": "2026-03-10",
    "apiSurface": "github-api-surface.json",
    "fineGrainedPatPermissions": "https://docs.github.com/en/rest/authentication/permissions-required-for-fine-grained-personal-access-tokens?apiVersion=2026-03-10",
    "githubAppPermissions": "https://docs.github.com/en/rest/authentication/permissions-required-for-github-apps?apiVersion=2026-03-10",
    "classicScopes": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/scopes-for-oauth-apps"
  },
  "permissions": [
    {
      "id": "classic-repo",
      "tokenType": "classic-pat",
      "scope": "account",
      "name": "repo",
      "access": "read-write",
      "description": "Coarse classic scope required by the current CLI preflight for every command."
    },
    {
      "id": "classic-admin-org",
      "tokenType": "classic-pat",
      "scope": "organization",
      "name": "admin:org",
      "access": "write",
      "description": "Additional classic scope required before organization custom-property writes."
    },
    {
      "id": "classic-read-org",
      "tokenType": "classic-pat",
      "scope": "organization",
      "name": "read:org",
      "access": "read",
      "description": "Classic scope for reading the organization's members, outside collaborators and invitations."
    },
    {
      "id": "repository-metadata-read",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Metadata",
      "access": "read",
      "description": "Repository discovery and public repository metadata."
    },
    {
      "id": "repository-administration-read",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Administration",
      "access": "read",
      "description": "Administrative settings, rulesets, environments, and security configuration state."
    },
    {
      "id": "repository-administration-write",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Administration",
      "access": "write",
      "description": "Repository settings, branch rename, rulesets, environments, and supported security configuration changes."
    },
    {
      "id": "repository-contents-read",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Contents",
      "access": "read",
      "description": "Repository files, workflows, branches, and Git references used as observed state."
    },
    {
      "id": "repository-contents-write",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Contents",
      "access": "write",
      "description": "Branch creation and create-if-missing file writes."
    },
    {
      "id": "repository-issues-read",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Issues",
      "access": "read",
      "description": "Reading the labels and milestones a repository already has."
    },
    {
      "id": "repository-issues-write",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Issues",
      "access": "write",
      "description": "Creating, renaming and deleting labels and milestones."
    },
    {
      "id": "repository-custom-properties-read",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Custom properties",
      "access": "read",
      "description": "Reading the custom property values set on one repository."
    },
    {
      "id": "repository-custom-properties-write",
      "tokenType": "fine-grained",
      "scope": "repository",
      "name": "Custom properties",
      "access": "write",
      "description": "Setting and unsetting custom property values on one repository."
    },
    {
      "id": "organization-custom-properties-read",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Custom properties",
      "access": "read",
      "description": "Organization repository property definitions and values."
    },
    {
      "id": "organization-custom-properties-write",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Custom properties",
      "access": "write",
      "description": "Organization repository property values."
    },
    {
      "id": "organization-custom-properties-admin",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Custom properties",
      "access": "admin",
      "description": "Organization custom-property definitions."
    },
    {
      "id": "organization-administration-read",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Administration",
      "access": "read",
      "description": "Reading the organization's own profile and member policies."
    },
    {
      "id": "organization-administration-write",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Administration",
      "access": "write",
      "description": "Organization ruleset capability discovery, and writing the organization's own profile and member policies."
    },
    {
      "id": "organization-members-read",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Members",
      "access": "read",
      "description": "Reading the organization's teams."
    },
    {
      "id": "organization-members-write",
      "tokenType": "fine-grained",
      "scope": "organization",
      "name": "Members",
      "access": "write",
      "description": "Creating, updating and deleting the organization's teams."
    }
  ],
  "routePermissions": {
