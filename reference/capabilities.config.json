      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["A forbidden or unavailable endpoint is reported as unreadable state."]
    },
    {
      "id": "private-vulnerability-reporting",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.private_vulnerability_reporting"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/private-vulnerability-reporting"],
      "writeRoutes": ["PUT /repos/{owner}/{repo}/private-vulnerability-reporting", "DELETE /repos/{owner}/{repo}/private-vulnerability-reporting"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["A forbidden or unavailable endpoint is reported as unreadable state."]
    },
    {
      "id": "code-scanning-default-setup",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.code_scanning_default_setup"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/code-scanning/default-setup"],
      "writeRoutes": ["PATCH /repos/{owner}/{repo}/code-scanning/default-setup"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["A forbidden or unavailable endpoint is reported as unreadable state."]
    },
    {
      "id": "immutable-releases",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.immutable_releases"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/immutable-releases"],
      "writeRoutes": [
        "PUT /repos/{owner}/{repo}/immutable-releases",
        "DELETE /repos/{owner}/{repo}/immutable-releases"
      ],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "An owner that enforces immutable releases leaves the setting readable but not writable, so a change is reported as blocked rather than attempted."
      ]
    },
    {
      "id": "default-branch-rename",
      "area": "branches",
      "support": "supported",
      "configPaths": ["default_branch.name", "default_branch.rename_from"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}", "GET /repos/{owner}/{repo}/contents/{path}"],
      "writeRoutes": ["POST /repos/{owner}/{repo}/branches/{branch}/rename"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-metadata-read", "repository-contents-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["Rename is guarded by rename_from and workflow references are reported but never rewritten."]
    },
    {
      "id": "ensured-branches",
      "area": "branches",
      "support": "supported",
      "configPaths": ["ensure_branches"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/branches/{branch}", "GET /repos/{owner}/{repo}/git/ref/{ref}"],
      "writeRoutes": ["POST /repos/{owner}/{repo}/git/refs"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-contents-read"],
      "writePermissions": ["classic-repo", "repository-contents-write"],
      "limitations": ["A missing branch is created from the current default branch; existing branches are never changed or deleted."]
    },
    {
      "id": "branch-protection",
      "area": "branches",
      "support": "supported",
      "configPaths": ["branch_protection"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": [
        "GET /repos/{owner}/{repo}/branches/{branch}/protection",
        "GET /repos/{owner}/{repo}/branches/{branch}"
      ],
      "writeRoutes": [
        "PUT /repos/{owner}/{repo}/branches/{branch}/protection",
        "POST /repos/{owner}/{repo}/branches/{branch}/protection/required_signatures",
        "DELETE /repos/{owner}/{repo}/branches/{branch}/protection/required_signatures"
      ],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "The update endpoint has no partial form and reads an omitted member as a removal, so the current protection is read and declared keys are folded over it.",
        "Protection is never removed from a branch the policy stops naming; only a declared value changes anything.",
        "A branch also governed by a declared ruleset is blocked on both sides, because GitHub applies both and the stricter wins per rule."
      ]
    },
    {
      "id": "repository-rulesets",
      "area": "rules",
      "support": "supported-with-capability-evidence",
      "configPaths": ["rulesets"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": [
        "GET /orgs/{org}/rulesets",
        "GET /repos/{owner}/{repo}/branches/{branch}/protection",
        "GET /repos/{owner}/{repo}/rulesets",
        "GET /repos/{owner}/{repo}/rulesets/{ruleset_id}"
      ],
      "writeRoutes": ["POST /repos/{owner}/{repo}/rulesets", "PUT /repos/{owner}/{repo}/rulesets/{ruleset_id}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": [
        "Private repositories require positive owner, repository, token, and API evidence; unknown remote rule types are not removed.",
        "That evidence can be gathered before it matters with octoform inspect capabilities --repo <name>, which probes a private repository and reports the answer with its source."
      ]
    },
    {
      "id": "organization-teams",
      "area": "organization",
      "support": "supported",
      "configPaths": ["organization.teams"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization"],
      "readRoutes": ["GET /orgs/{org}/teams"],
      "writeRoutes": [
        "POST /orgs/{org}/teams",
        "PATCH /orgs/{org}/teams/{team_slug}",
        "DELETE /orgs/{org}/teams/{team_slug}"
      ],
      "writeMutations": [],
      "readPermissions": ["classic-admin-org", "organization-members-read"],
      "writePermissions": ["classic-admin-org", "organization-members-write"],
      "limitations": [
