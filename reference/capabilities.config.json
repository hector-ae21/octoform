      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": []
    },
    {
      "id": "secret-scanning-settings",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.secret_scanning", "security.secret_scanning_push_protection"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}"],
      "writeRoutes": ["PATCH /repos/{owner}/{repo}"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["An omitted security_and_analysis field is unreadable and blocks mutation instead of being treated as disabled."]
    },
    {
      "id": "vulnerability-alerts",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.vulnerability_alerts"],
      "commands": ["plan", "apply"],
      "ownerKinds": ["organization", "personal"],
      "readRoutes": ["GET /repos/{owner}/{repo}/vulnerability-alerts"],
      "writeRoutes": ["PUT /repos/{owner}/{repo}/vulnerability-alerts", "DELETE /repos/{owner}/{repo}/vulnerability-alerts"],
      "writeMutations": [],
      "readPermissions": ["classic-repo", "repository-administration-read"],
      "writePermissions": ["classic-repo", "repository-administration-write"],
      "limitations": ["A forbidden or unavailable endpoint is reported as unreadable state."]
    },
    {
      "id": "automated-security-fixes",
      "area": "security",
      "support": "supported",
      "configPaths": ["security.automated_security_fixes"],
      "commands": ["plan", "apply"],
